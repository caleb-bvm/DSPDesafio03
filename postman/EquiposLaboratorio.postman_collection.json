{
  "info": {
    "name": "Equipos de Laboratorio · casos de defensa",
    "description": "Ejecutar en orden. Completar adminPassword y studentPassword como variables locales en Postman antes de iniciar. Los casos 11 y 12 se verifican manualmente en MVC y Reportes. No guardar contraseñas reales en el archivo exportado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API · ejecución ordenada",
      "item": [
        {
          "name": "01 · Login Admin (caso 1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set(\"adminToken\", r.token);",
                  "pm.test(\"Token y rol Admin\", () => {",
                  "  pm.expect(r.rol).to.eql(\"Admin\");",
                  "  const payload = JSON.parse(atob(r.token.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\")));",
                  "  pm.expect(Object.values(payload)).to.include(\"Admin\");",
                  "});"
                ]
              }
            }
          ]
        },
