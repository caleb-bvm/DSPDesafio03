# Plantilla de .env para Docker. No escriba aquí valores reales.
# iniciar.ps1 crea .env con valores aleatorios si no existe.
# Para hacerlo a mano, copie este archivo como .env y cambie cada valor.
# Las contraseñas de la base solo se aplican cuando esta se crea:
# si las cambia después, ejecute .\iniciar.ps1 -ReiniciarBase.

# Usuario sa de SQL Server. Debe tener mayúscula, minúscula, número y símbolo.
SA_PASSWORD=Cambiar-Esta-Clave-1

# Usuario de solo lectura "reportes" de SQL Server. Mismas reglas que SA_PASSWORD.
REPORTES_PASSWORD=Cambiar-Esta-Clave-2

# Contraseña del Admin inicial de la API.
ADMIN_PASSWORD=Cambiar-Admin

# Contraseña de los usuarios de demostración.
DEMO_PASSWORD=Cambiar-Demo

# Clave con la que se firman los JWT. Mínimo 32 caracteres.
JWT_KEY=cambiar_por_una_clave_aleatoria_de_64_caracteres

# Zona horaria de los contenedores.
TZ=America/El_Salvador
