@using EquiposMVC.Services
@{
    // Datos de la sesión guardados en AuthController.Login.
    var rol = Context.Session.GetString(SessionKeys.Rol);
    var username = Context.Session.GetString(SessionKeys.Username);
    var autenticado = !string.IsNullOrWhiteSpace(Context.Session.GetString(SessionKeys.Token));
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var reportesUrl = Context.RequestServices.GetRequiredService<IConfiguration>()["Reportes:BaseUrl"];
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Laboratorio</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" asp-controller="Equipo" asp-action="Index" aria-label="Laboratorio, inicio">
                <span class="brand-mark" aria-hidden="true">L</span>
                <span>Laboratorio</span>
            </a>
            @if (autenticado)
            {
                @* Menú por rol: el Estudiante solo ve "Equipos" (disponibles) y "Mis préstamos". El Docente además ve "Alumnos" (solo lectura). El Admin ve todo. *@
                <nav class="main-nav" aria-label="Navegación principal">
                    <a class="nav-link @(controller == "Equipo" ? "active" : "")" asp-controller="Equipo" asp-action="Index">Equipos</a>
                    <a class="nav-link @(controller == "Prestamo" ? "active" : "")" asp-controller="Prestamo" asp-action="Index">@(rol == "Estudiante" ? "Mis préstamos" : "Préstamos")</a>
                    @if (rol == "Admin")
                    {
                        <a class="nav-link @(controller == "Categoria" ? "active" : "")" asp-controller="Categoria" asp-action="Index">Categorías</a>
                        <a class="nav-link @(controller == "Auth" ? "active" : "")" asp-controller="Auth" asp-action="Usuarios">Usuarios</a>
                        @if (!string.IsNullOrWhiteSpace(reportesUrl))
                        {
                            <a class="nav-link" href="@reportesUrl">Reportes</a>
                        }
                    }
                    else if (rol == "Docente")
                    {
                        <a class="nav-link @(controller == "Auth" ? "active" : "")" asp-controller="Auth" asp-action="Alumnos">Alumnos</a>
                    }
                </nav>
                <div class="account">
                    <span class="account-name"><strong>@username</strong><small>@rol</small></span>
                    <form asp-controller="Auth" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="icon-button" title="Cerrar sesión" aria-label="Cerrar sesión">Salir</button>
                    </form>
                </div>
            }
        </div>
    </header>
    <main id="contenido" class="page-container">
        @* Mensajes de una sola vez (por ejemplo, "Tu sesión venció" después de un 401). *@
        @if (TempData["Error"] is string error)
        {
            <div class="notice notice-error" role="alert">@error</div>
        }
        @if (TempData["Success"] is string success)
        {
            <div class="notice notice-success" role="status">@success</div>
        }
        @RenderBody()
    </main>
    <footer class="site-footer"><span>Préstamos de equipos · Laboratorio</span></footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
