@model List<UsuarioDto>
@{
    ViewData["Title"] = "Usuarios";
}
<div class="page-heading">
    <div><span class="eyebrow">Administración</span><h1>Usuarios</h1><p>Cuentas con acceso al sistema y sus permisos.</p></div>
    <a class="button button-primary" asp-action="Register">Registrar usuario</a>
</div>
<section class="list-card">
    @if (Model.Count == 0)
    {
        <div class="empty-state"><h2>Aún no hay usuarios</h2><p>Registra el primero para darle acceso.</p></div>
    }
    else
    {
        <div class="table-scroll">
            <table>
                <thead><tr><th>Usuario</th><th>Correo</th><th>Rol</th></tr></thead>
                <tbody>
                @foreach (var usuario in Model)
                {
                    <tr>
                        <td><strong>@usuario.Username</strong></td>
                        <td>@usuario.Email</td>
                        <td><span class="status status-@usuario.Rol.ToLowerInvariant()">@usuario.Rol</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
